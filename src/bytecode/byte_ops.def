BYTE_OP(SRem, "srem", InstClass::R, i64, i64, i64)
BYTE_OP(URem, "urem", InstClass::R, u64, u64, u64)
BYTE_OP(SRemi, "sremi", InstClass::I, i64, _, i16)
BYTE_OP(URemi, "uremi", InstClass::IU, u64, _, u16)
BYTE_OP(Neg, "neg", InstClass::R, i64, i64, _)
BYTE_OP(And, "and", InstClass::R, u64, u64, u64)
BYTE_OP(Andi, "andi", InstClass::IU, u64, _, u16)
BYTE_OP(Or, "or", InstClass::R, u64, u64, u64)
BYTE_OP(Ori, "ori", InstClass::IU, u64, _, u16)
BYTE_OP(Xor, "xor", InstClass::R, u64, u64, u64)
BYTE_OP(Xori, "xori", InstClass::IU, u64, _, u16)
BYTE_OP(Not, "not", InstClass::R, u64, u64, _)
BYTE_OP(Notu, "notu", InstClass::RIU, u64, u64, u8)
BYTE_OP(Shl, "shl", InstClass::R, u64, u64, u64)
BYTE_OP(Shli, "shli", InstClass::IU, u64, _, u16)
BYTE_OP(Lsr, "lsr", InstClass::R, u64, u64, u64)
BYTE_OP(Lsri, "lsri", InstClass::IU, u64, _, u16)
BYTE_OP(Asr, "asr", InstClass::R, i64, i64, u64)
BYTE_OP(Asri, "asri", InstClass::IU, i64, _, u16)

BYTE_OP(ChkS8, "chks8", InstClass::R, _, i64, _)
BYTE_OP(ChkU8, "chku8", InstClass::R, _, u64, _)
BYTE_OP(ChkS16, "chks16", InstClass::R, _, i64, _)
BYTE_OP(ChkU16, "chku16", InstClass::R, _, u64, _)
