BYTE_OP(USub, "usub", InstClass::R, u64, u64, u64)
BYTE_OP(SSubi, "ssubi", InstClass::I, i64, _, i16)
BYTE_OP(USubi, "usubi", InstClass::IU, u64, _, u16)
BYTE_OP(SMul, "smul", InstClass::R, i64, i64, i64)
BYTE_OP(UMul, "umul", InstClass::R, u64, u64, u64)
BYTE_OP(SMuli, "smuli", InstClass::I, i64, _, i16)
BYTE_OP(UMuli, "umuli", InstClass::IU, u64, _, u16)
