BYTE_OP(ChkU32, "chku32", InstClass::R, _, u64, _)

BYTE_OP(LoadConst, "ldc", InstClass::IU, u64, _, u16)
BYTE_OP(LoadImm, "ldi", InstClass::I, i64, _, i16)

BYTE_OP(Mov, "mov", InstClass::R, u64, u64, _)

BYTE_OP(Eq, "eq", InstClass::R, u64, u64, u64)
BYTE_OP(EqF, "eq.f", InstClass::R, u64, double, double)
BYTE_OP(Ne, "ne", InstClass::R, u64, u64, u64)
BYTE_OP(NeF, "ne.f", InstClass::R, u64, double, double)
BYTE_OP(Lt, "lt", InstClass::R, u64, i64, i64)
