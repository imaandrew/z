#ifndef BYTE_OP
#define BYTE_OP(name, mnemonic, class...)
#endif

BYTE_OP(SAdd, "sadd", InstClass::R, i64, i64, i64)
BYTE_OP(UAdd, "uadd", InstClass::R, u64, u64, u64)
BYTE_OP(SAddi, "saddi", InstClass::I, i64, _, i16)
BYTE_OP(UAddi, "uaddi", InstClass::IU, u64, _, u16)
